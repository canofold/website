{
  "name": "@canofold/website",
  "private": true,
  "version": "0.1.0",
  "description": "Official Canofold website and documentation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "canofold dev",
    "check": "canofold check",
    "build": "canofold build",
    "build:clean": "canofold build --no-cache",
    "preview": "canofold preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.e2e.json",
    "audit:site": "node scripts/audit-site.mjs",
    "report": "node scripts/site-artifact-report.mjs",
    "test:e2e": "playwright test",
    "test": "pnpm typecheck && pnpm check && pnpm build:clean && pnpm audit:site && pnpm report",
    "test:ci": "pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@canofold/plugins": "^0.2.1",
    "canofold": "^0.2.1",
    "mermaid": "^11.17.2",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "jsdom": "30.0.1",
    "typescript": "^6.0.3"
  }
}
